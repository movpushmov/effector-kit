{
  "name": "@effector-kit/models",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "private": false,
  "version": "0.1.0",
  "description": "Effector dynamic models runtime",
  "keywords": [
    "effector",
    "models",
    "dynamic",
    "forms",
    "effector-kit",
    "effector",
    "kit"
  ],
  "author": "movpushmov",
  "homepage": "https://github.com/movpushmov/effector-kit#readme",
  "license": "MIT",
  "directories": {
    "lib": "lib"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "import": "./dist/react.mjs",
      "require": "./dist/react.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/movpushmov/effector-kit.git"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "changeset": "pnpm -w changeset",
    "release:targets": "pnpm -w release:targets",
    "release:verify": "pnpm -w release:verify",
    "release:status": "pnpm -w release:status",
    "release:version": "pnpm -w release:version",
    "release:publish": "pnpm -w release:publish"
  },
  "bugs": {
    "url": "https://github.com/movpushmov/effector-kit/issues"
  },
  "peerDependencies": {
    "effector": ">=23.4.4",
    "effector-action": ">=1.2.2"
  },
  "devDependencies": {
    "effector": "23.4.4",
    "effector-action": "1.2.2"
  },
  "packageManager": "pnpm@10.10.0"
}
