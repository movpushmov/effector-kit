{
  "name": "@effector-kit/root",
  "private": true,
  "version": "0.0.0",
  "description": "Root package of effector kit",
  "license": "MIT",
  "packageManager": "pnpm@10.10.0",
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@effector/swc-plugin": "^1.0.0",
    "@swc/core": "^1.15.18",
    "tsdown": "^0.20.1",
    "unplugin-swc": "^1.5.9",
    "vitepress": "^1.6.4",
    "vitest": "^4.0.18"
  },
  "scripts": {
    "changeset": "changeset",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "release:targets": "node ./scripts/release/run.mjs list",
    "release:build": "node ./scripts/release/run.mjs build",
    "release:test": "node ./scripts/release/run.mjs test",
    "release:verify": "node ./scripts/release/run.mjs verify",
    "release:status": "changeset status --verbose",
    "release:version": "changeset version && pnpm install",
    "release:publish": "pnpm release:verify && node ./scripts/release/publish.mjs"
  }
}
